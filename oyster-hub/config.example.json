{
  "host": "127.0.0.1",
  "port": 8787,
  "token": "replace-with-a-hub-bearer-token",
  "timeoutMs": 5000,
  "uploadIdleTimeoutMs": 30000,
  "uploadResponseTimeoutMs": 30000,
  "cloud": {
    "stateFile": "./cloud-state.json"
  },
  "driver": {
    "type": "llmbox",
    "transport": "native",
    "binding": {
      "addonPath": "llmbox/bindings/build/llmbox.node",
      "configPath": "llmbox.yaml",
      "closeTimeoutMs": 5000
    },
    "tokenSecret": "replace-with-a-stable-random-workspace-token-secret",
    "workspacePort": 8080,
    "createProxy": true,
    "tokenFile": {
      "path": "/run/secrets/oyster-ui-token",
      "mode": 384,
      "uid": 0,
      "gid": 0
    }
  }
}
