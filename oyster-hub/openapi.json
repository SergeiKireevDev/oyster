{
  "openapi": "3.1.0",
  "info": {
    "title": "Oyster Hub API",
    "version": "0.1.0",
    "description": "Driver-backed workspace provisioning, aggregation, and scoped proxy API for Oyster servers. The prototype driver is llmbox."
  },
  "servers": [{ "url": "/api/v1" }],
  "security": [{ "bearerAuth": [] }],
  "paths": {
    "/environments": {
      "get": {
        "summary": "List driver-discovered and cloud environments",
        "responses": { "200": { "description": "Environment list", "content": { "application/json": { "schema": { "type": "object", "required": ["environments"], "properties": { "environments": { "type": "array", "items": { "$ref": "#/components/schemas/Environment" } } } } } } } }
      },
      "post": {
        "summary": "Provision a reverse-connected Oyster VM with a configured cloud provider",
        "description": "Applies provider-native cloud-init, installs Oyster from source, and registers an outbound WSS channel to the Hub.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateCloudEnvironment" } } } },
        "responses": { "201": { "description": "Cloud instance created", "content": { "application/json": { "schema": { "type": "object", "required": ["environment"], "properties": { "environment": { "$ref": "#/components/schemas/Environment" } } } } } }, "400": { "description": "Invalid request" }, "409": { "description": "Provider credentials are not configured" }, "502": { "description": "Cloud provider request failed" } }
      }
    },
    "/environments/{environmentId}": {
      "parameters": [{ "$ref": "#/components/parameters/EnvironmentId" }],
      "delete": {
        "summary": "Permanently destroy a managed cloud environment",
        "description": "Deletes the provider VM and disk, revokes its reverse-connection credential, and removes its Hub record.",
        "responses": { "200": { "description": "Cloud environment destroyed" }, "404": { "description": "Cloud environment not found" }, "502": { "description": "Cloud provider request failed" } }
      }
    },
    "/environments/{environmentId}/actions": {
      "parameters": [{ "$ref": "#/components/parameters/EnvironmentId" }],
      "post": {
        "summary": "Pause or resume a managed cloud environment",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CloudEnvironmentAction" } } } },
        "responses": { "200": { "description": "Cloud lifecycle action accepted" }, "400": { "description": "Invalid action" }, "404": { "description": "Cloud environment not found" }, "409": { "description": "Environment state does not allow the action" }, "502": { "description": "Cloud provider request failed" } }
      }
    },
    "/cloud/providers": {
      "get": {
        "summary": "List supported cloud providers and redacted credential status",
        "responses": { "200": { "description": "Cloud provider catalog", "content": { "application/json": { "schema": { "type": "object", "required": ["providers"], "properties": { "providers": { "type": "array", "items": { "$ref": "#/components/schemas/CloudProvider" } } } } } } } }
      }
    },
    "/cloud/providers/{provider}/credentials": {
      "parameters": [{ "$ref": "#/components/parameters/CloudProviderId" }],
      "put": { "summary": "Store or replace cloud credentials", "description": "Secret values are write-only and are never included in API responses.", "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "additionalProperties": true } } } }, "responses": { "200": { "description": "Credential configured" }, "400": { "description": "Invalid credentials" } } },
      "delete": { "summary": "Remove stored cloud credentials", "responses": { "200": { "description": "Credential removed" } } }
    },
    "/cloud/providers/{provider}/options": {
      "parameters": [{ "$ref": "#/components/parameters/CloudProviderId" }, { "name": "region", "in": "query", "schema": { "type": "string" }, "description": "Region or zone used to query available instance types" }],
      "get": { "summary": "Query live regions, instance types, and images from a cloud provider", "responses": { "200": { "description": "Available provisioning options", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CloudOptions" } } } }, "409": { "description": "Provider credentials are not configured" }, "502": { "description": "Cloud provider request failed" } } }
    },
    "/cloud/providers/{provider}/authorization/start": {
      "post": { "summary": "Start DigitalOcean or Google browser authorization", "parameters": [{ "$ref": "#/components/parameters/CloudProviderId" }], "responses": { "202": { "description": "Authorization flow created" }, "409": { "description": "Provider OAuth client is not configured" } } }
    },
    "/cloud/authorization/{flowId}/status": {
      "get": { "summary": "Read a safe authorization flow snapshot", "parameters": [{ "name": "flowId", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Authorization status" }, "404": { "description": "Flow expired or not found" } } }
    },
    "/cloud/providers/{provider}/projects": {
      "get": { "summary": "List selectable Google Cloud projects", "parameters": [{ "$ref": "#/components/parameters/CloudProviderId" }], "responses": { "200": { "description": "Safe project list" } } },
      "post": { "summary": "Select the Google Cloud project used for provisioning", "parameters": [{ "$ref": "#/components/parameters/CloudProviderId" }], "responses": { "200": { "description": "Project selected" } } }
    },
    "/cloud/providers/aws/role/start": {
      "post": { "summary": "Start AWS CloudFormation cross-account role onboarding", "responses": { "202": { "description": "AWS setup flow created" }, "409": { "description": "Hub AWS onboarding is not configured" } } }
    },
    "/workspaces": {
      "get": {
        "summary": "Query the configured driver and list discovered workspaces",
        "responses": { "200": { "description": "Workspace list", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WorkspaceList" } } } } }
      },
      "post": {
        "summary": "Create a workspace through the configured driver",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateWorkspace" } } } },
        "responses": {
          "201": { "description": "Workspace created", "content": { "application/json": { "schema": { "type": "object", "required": ["workspace"], "properties": { "workspace": { "$ref": "#/components/schemas/Workspace" } } } } } },
          "400": { "description": "Invalid workspace request" },
          "405": { "description": "Selected driver cannot create workspaces" },
          "502": { "description": "Workspace driver failure" }
        }
      }
    },
    "/overview": {
      "get": {
        "summary": "Aggregate runners, sessions, routines, and hublots from every workspace",
        "responses": { "200": { "description": "Cross-workspace overview", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Overview" } } } } }
      }
    },
    "/workspaces/{wid}": {
      "get": {
        "summary": "Get one workspace and its availability",
        "parameters": [{ "$ref": "#/components/parameters/WorkspaceId" }],
        "responses": {
          "200": { "description": "Workspace status", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Workspace" } } } },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "delete": {
        "summary": "Remove a workspace when supported by the selected driver",
        "parameters": [{ "$ref": "#/components/parameters/WorkspaceId" }],
        "responses": { "405": { "description": "Selected driver cannot remove workspaces" } }
      }
    },
    "/workspaces/{wid}/{path}": {
      "parameters": [
        { "$ref": "#/components/parameters/WorkspaceId" },
        { "name": "path", "in": "path", "required": true, "description": "An Oyster server path, including nested path segments (for example analytics/usage).", "schema": { "type": "string" } }
      ],
      "get": { "summary": "Proxy a GET to one Oyster workspace", "responses": { "200": { "description": "Upstream response" }, "default": { "description": "Upstream status and response" } } },
      "post": { "summary": "Proxy a POST to one Oyster workspace", "responses": { "default": { "description": "Upstream status and response" } } },
      "patch": { "summary": "Proxy a PATCH to one Oyster workspace", "responses": { "default": { "description": "Upstream status and response" } } },
      "delete": { "summary": "Proxy a DELETE to one Oyster workspace", "responses": { "default": { "description": "Upstream status and response" } } }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer" }
    },
    "parameters": {
      "WorkspaceId": { "name": "wid", "in": "path", "required": true, "schema": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$" } },
      "EnvironmentId": { "name": "environmentId", "in": "path", "required": true, "schema": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,127}$" } },
      "CloudProviderId": { "name": "provider", "in": "path", "required": true, "schema": { "type": "string", "enum": ["digitalocean", "hetzner", "aws", "gcp"] } }
    },
    "responses": {
      "NotFound": { "description": "Workspace not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
    },
    "schemas": {
      "Error": { "type": "object", "required": ["error"], "properties": { "error": { "type": "string" } } },
      "Environment": {
        "type": "object",
        "required": ["id", "name", "status"],
        "properties": {
          "id": { "type": "string", "description": "llmbox spoke name" },
          "name": { "type": "string" },
          "status": { "enum": ["provisioning", "awaiting_agent", "initializing", "online", "offline", "failed", "provisioned", "paused", "pausing", "resuming", "destroying"] },
          "default": { "type": "boolean" },
          "local": { "type": "boolean" },
          "cloud": { "type": "boolean" },
          "createdAt": { "type": "string", "format": "date-time" },
          "provider": { "type": "object", "additionalProperties": true }
        }
      },
      "CloudProvider": {
        "type": "object",
        "required": ["id", "name", "configured", "authMethods"],
        "properties": {
          "id": { "enum": ["digitalocean", "hetzner", "aws", "gcp"] },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "configured": { "type": "boolean" },
          "account": { "type": ["string", "null"], "description": "Non-secret account identifier when available" },
          "credentialType": { "type": ["string", "null"] },
          "requiresProject": { "type": "boolean" },
          "authMethods": { "type": "array", "items": { "type": "object", "required": ["id", "label", "available"], "properties": { "id": { "enum": ["oauth_redirect", "assume_role", "api_token", "access_key", "service_account_file"] }, "label": { "type": "string" }, "primary": { "type": "boolean" }, "advanced": { "type": "boolean" }, "available": { "type": "boolean" }, "fields": { "type": "array", "items": { "type": "object", "additionalProperties": true } } } } }
        }
      },
      "CloudOptions": {
        "type": "object",
        "required": ["provider", "regions", "sizes", "images", "defaults"],
        "properties": {
          "provider": { "type": "string" },
          "regions": { "type": "array", "items": { "$ref": "#/components/schemas/CloudOption" } },
          "sizes": { "type": "array", "items": { "$ref": "#/components/schemas/CloudOption" } },
          "images": { "type": "array", "items": { "$ref": "#/components/schemas/CloudOption" } },
          "defaults": { "type": "object", "properties": { "region": { "type": "string" }, "size": { "type": "string" }, "image": { "type": "string" } } }
        }
      },
      "CloudOption": { "type": "object", "required": ["id", "name"], "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "description": { "type": "string" }, "regions": { "type": "array", "items": { "type": "string" } } } },
      "CreateCloudEnvironment": { "type": "object", "required": ["provider", "name", "region", "size", "image"], "properties": { "provider": { "enum": ["digitalocean", "aws", "gcp"] }, "name": { "type": "string", "pattern": "^[A-Za-z](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?$" }, "region": { "type": "string" }, "size": { "type": "string" }, "image": { "type": "string" } } },
      "CloudEnvironmentAction": { "type": "object", "required": ["action"], "properties": { "action": { "enum": ["pause", "resume"] } } },
      "Workspace": {
        "type": "object",
        "required": ["environmentId", "environmentName", "id", "name", "url"],
        "properties": {
          "environmentId": { "type": "string", "description": "Physical or cloud device ID" },
          "environmentName": { "type": "string", "description": "Physical or cloud device label" },
          "id": { "type": "string", "description": "Project microVM ID" },
          "name": { "type": "string" },
          "url": { "type": ["string", "null"], "format": "uri" },
          "status": { "enum": ["online", "offline", "provisioning", "awaiting_agent", "initializing", "paused", "pausing", "resuming", "destroying", "failed"] },
          "latencyMs": { "type": ["integer", "null"] },
          "provider": { "type": "object", "additionalProperties": true },
          "results": { "type": "object", "additionalProperties": true },
          "errors": { "type": "object", "additionalProperties": { "type": "string" } }
        }
      },
      "WorkspaceList": { "type": "object", "required": ["driver", "workspaces"], "properties": { "driver": { "type": "object", "required": ["type", "endpoint", "capabilities"], "properties": { "type": { "type": "string" }, "endpoint": { "type": "string", "format": "uri" }, "capabilities": { "type": "object", "required": ["list", "create", "remove"], "properties": { "list": { "type": "boolean" }, "create": { "type": "boolean" }, "remove": { "type": "boolean" } } } } }, "workspaces": { "type": "array", "items": { "$ref": "#/components/schemas/Workspace" } } } },
      "CreateWorkspace": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$" },
          "name": { "type": "string", "maxLength": 500 },
          "spoke": { "type": "string", "maxLength": 100 },
          "diskBytes": { "type": "integer", "minimum": 0 }
        }
      },
      "Overview": {
        "type": "object",
        "required": ["generatedAt", "totals", "workspaces"],
        "properties": {
          "generatedAt": { "type": "string", "format": "date-time" },
          "totals": { "type": "object", "additionalProperties": { "type": "integer" } },
          "workspaces": { "type": "array", "items": { "$ref": "#/components/schemas/Workspace" } }
        }
      }
    }
  }
}
