{
  "name": "oyster",
  "version": "0.1.0",
  "description": "Web UI for interacting with the pi coding agent remotely through a tunnel",
  "type": "module",
  "main": "server/server.mjs",
  "scripts": {
    "start": "node server/server.mjs",
    "hub": "node oyster-hub/server.mjs",
    "hub:mock": "node oyster-hub/server.mjs --config oyster-hub/config.mock.example.json",
    "dev": "vite --config vite.config.js",
    "build": "vite build --config vite.config.js",
    "build:pi": "cd pi && npx --no-install tsgo -p packages/tui/tsconfig.build.json && npm run build --workspace packages/ai && npm run build --workspace packages/agent && npm run build --workspace packages/storage/sqlite-node && npm run build --workspace packages/coding-agent",
    "build:llmbox-bindings": "cd llmbox && make build-node-bindings",
    "benchmark:uploads": "node --expose-gc scripts/benchmark-workspace-upload.mjs",
    "docs:build": "node scripts/build-docs.mjs",
    "preview": "vite preview --config vite.config.js",
    "perf:prepare-longcat": "bash tests/performance/prepare-longcat-container.sh",
    "perf:switch-sessions": "node tests/performance/session-switches.mjs",
    "perf:switch-sessions-live": "PERF_SWITCH_REVIVE=1 node tests/performance/session-switches.mjs",
    "migrate-app-data": "node scripts/migrate-app-data.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "svelte": "^5.35.0",
    "vite": "^6.3.5"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT",
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "katex": "^0.16.47",
    "sqlite3": "^5.1.7",
    "web-push": "^3.6.7",
    "ws": "^8.21.1"
  }
}
